{
  "providerIdentifier": "com.vaultwarden",
  "displayName": "Vaultwarden",
  "color": "#175DDC",
  "grouping": ["${metadata.IP}"],
  "groupingWindow": "1h",
  "severityDefault": { "severity": "info", "label": "Info" },
  "severityRules": [
    { "match": { "Event": "login_failed_burst" }, "severity": "error",   "label": "Brute-force?" },
    { "match": { "Event": "admin_login_failed" }, "severity": "warning", "label": "Admin probe" },
    { "match": { "Event": "user_created" },       "severity": "warning", "label": "New user" },
    { "match": { "Event": "vault_exported" },     "severity": "warning", "label": "Vault export" },
    { "match": { "Event": "admin_login" },        "severity": "info",    "label": "Admin" },
    { "match": { "Event": "login_failed" },       "severity": "info",    "label": "Login fail" },
    { "match": { "Event": "user_login" },         "severity": "info",    "label": "Login" }
  ],
  "defaultActions": [
    { "label": "Open vault",          "systemIcon": "lock.shield",            "trigger": { "openURL": "${metadata.ServerUrl}/" } },
    { "label": "Open admin",          "systemIcon": "person.badge.key",       "trigger": { "openURL": "${metadata.ServerUrl}/admin/" } },
    { "label": "Copy source IP",      "systemIcon": "network",                "trigger": { "copyToClipboard": "${metadata.IP}" } },
    { "label": "Check IP reputation", "systemIcon": "shield.lefthalf.filled", "trigger": { "openURL": "https://www.abuseipdb.com/check/${metadata.IP}" } },
    { "label": "Copy user email",     "systemIcon": "envelope",               "trigger": { "copyToClipboard": "${metadata.UserEmail}" } }
  ]
}
