# ----------------------------------------------------------------------------
# Validation
# ----------------------------------------------------------------------------

def _type_of(value: Any) -> str:
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, int):
        return "integer"
    if isinstance(value, float):
        return "number"
    if isinstance(value, str):
        return "string"
    if isinstance(value, list):
        return "array"
    if isinstance(value, dict):
        return "object"
    if value is None:
        return "null"
    return "unknown"


def _resolve_ref(ref: str, root: dict) -> dict:
    assert ref.startswith("#/"), f"only local refs supported, got {ref!r}"
    target = root
    for segment in ref[2:].split("/"):
        target = target[segment]
    return target


def _check_type(value: Any, expected: Any) -> bool:
    types = expected if isinstance(expected, list) else [expected]
    actual = _type_of(value)
    if actual in types:
        return True
    # JSON Schema convention: "number" accepts integers too.
    if "number" in types and actual == "integer":
        return True
    return False


def validate(value: Any, schema: dict, root: dict, path: str = "$") -> Iterator[tuple[str, str]]:
    if not isinstance(schema, dict):
        return

    if "$ref" in schema:
        yield from validate(value, _resolve_ref(schema["$ref"], root), root, path)
        return

    if "type" in schema and not _check_type(value, schema["type"]):
        yield (path, f"expected type {schema['type']!r}, got {_type_of(value)}")
        return

    if "enum" in schema and value not in schema["enum"]:
        yield (path, f"value {value!r} not in allowed set {schema['enum']!r}")

    if isinstance(value, str):
        if "pattern" in schema and not re.search(schema["pattern"], value):
            yield (path, f"value {value!r} doesn't match pattern {schema['pattern']!r}")
        if "minLength" in schema and len(value) < schema["minLength"]:
            yield (path, f"string too short (min {schema['minLength']}, got {len(value)})")
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            yield (path, f"string too long (max {schema['maxLength']}, got {len(value)})")

    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in schema and value < schema["minimum"]:
            yield (path, f"value {value} below minimum {schema['minimum']}")
        if "maximum" in schema and value > schema["maximum"]:
            yield (path, f"value {value} above maximum {schema['maximum']}")

    if isinstance(value, dict):
        for required in schema.get("required", []):
            if required not in value:
                yield (path, f"missing required field {required!r}")
        properties = schema.get("properties", {})
        additional = schema.get("additionalProperties", True)
        for key, sub in value.items():
            child_path = f"{path}.{key}"
            if key in properties:
                yield from validate(sub, properties[key], root, child_path)
            elif additional is False:
                yield (path, f"unexpected property {key!r}")
            elif isinstance(additional, dict):
                yield from validate(sub, additional, root, child_path)

    if isinstance(value, list):
        if "minItems" in schema and len(value) < schema["minItems"]:
            yield (path, f"array needs at least {schema['minItems']} items, got {len(value)}")
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            yield (path, f"array has at most {schema['maxItems']} items, got {len(value)}")
        items = schema.get("items")
        if items:
            for index, item in enumerate(value):
                yield from validate(item, items, root, f"{path}[{index}]")

    if "oneOf" in schema:
        matches = []
        sub_failure_msgs = []
        for sub in schema["oneOf"]:
            errors = list(validate(value, sub, root, path))
            if not errors:
                matches.append(sub)
            else:
                sub_failure_msgs.append(errors)
        if len(matches) == 0:
            details = "; ".join(
                f"#{i + 1}: " + (errors[0][1] if errors else "?")
                for i, errors in enumerate(sub_failure_msgs)
            )
            yield (path, f"matches none of the {len(schema['oneOf'])} oneOf branches ({details})")
        elif len(matches) > 1:
            yield (path, f"matches {len(matches)} oneOf branches (must match exactly one)")


# ----------------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------------

USE_COLOR = sys.stdout.isatty()

def _green(text: str) -> str:
    return f"\033[32m{text}\033[0m" if USE_COLOR else text

def _red(text: str) -> str:
    return f"\033[31m{text}\033[0m" if USE_COLOR else text

def _bold(text: str) -> str:
    return f"\033[1m{text}\033[0m" if USE_COLOR else text


def _parse_json(path: Path) -> tuple[Any, str | None]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return None, f"can't read file: {exc}"
    try:
        return json.loads(text), None
    except json.JSONDecodeError as exc:
        return None, f"JSON parse error at line {exc.lineno} col {exc.colno}: {exc.msg}"


def _validate_one(path: Path) -> bool:
    print(f"→ {_bold(str(path))}")
    parsed, error = _parse_json(path)
    if error:
        print(f"  {_red('✗')} {error}")
        return False
    errors = list(validate(parsed, SCHEMA, SCHEMA))
    if not errors:
        print(f"  {_green('✓ valid')}")
        return True
    for json_path, message in errors:
        print(f"  {_red('✗')} {json_path}: {message}")
    return False


def _expand_targets(targets: list[str]) -> list[Path]:
    expanded: list[Path] = []
    for raw in targets:
        path = Path(raw)
        if not path.exists():
            print(f"{_red('error')}: path not found: {raw}", file=sys.stderr)
            sys.exit(2)
        if path.is_dir():
            json_files = sorted(path.glob("*.json"))
            if not json_files:
                print(f"{_red('error')}: no *.json files in {path}/", file=sys.stderr)
                sys.exit(2)
            expanded.extend(json_files)
        else:
            expanded.append(path)
    return expanded


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="tempo-validate",
        description="Offline linter for Tempo Provider Score JSON files.",
    )
    parser.add_argument(
        "targets",
        nargs="+",
        help="One or more score files or directories. Directories are scanned for *.json.",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI color output (default: auto-detect TTY).",
    )
    args = parser.parse_args()

    if args.no_color:
        global USE_COLOR
        USE_COLOR = False

    paths = _expand_targets(args.targets)
    results = [_validate_one(p) for p in paths]

    passed = sum(results)
    failed = len(results) - passed
    print()
    if failed == 0:
        print(_green(f"All {passed} score(s) valid."))
        return 0
    print(_red(f"{failed} failed, {passed} passed (out of {len(results)})."))
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nAborted.", file=sys.stderr)
        sys.exit(3)
    except Exception as exc:
        print(f"internal error: {exc}", file=sys.stderr)
        sys.exit(3)
