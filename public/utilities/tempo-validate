#!/usr/bin/env python3
"""
tempo-validate — offline score linter for Tempo Provider Score JSON files.

Usage:
    tempo-validate path/to/score.json
    tempo-validate scores/                  # validate every *.json in dir
    tempo-validate a.json b.json c.json     # multiple files

Exit codes:
    0  all files valid
    1  one or more files failed validation
    2  file or directory not found
    3  internal error

The validator implements a minimal subset of JSON Schema Draft 7 sufficient
for the Tempo Provider Score schema. The schema is embedded in this file so
the tool is fully self-contained — no pip install, no network fetch.

Keep the embedded SCHEMA in sync with tempo-scores/schema/score.schema.json
whenever the score format evolves. The build script
(Scripts/release_tempo.sh) bundles this file into Tempo.app/Contents/Resources/
so end users get the schema matching their Tempo version.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any, Iterator

