---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Each shot: id (for lightbox anchor + filename slug), title, caption.
// Screenshots live in /public/gallery/<id>.png
type Shot = { id: string; title: string; caption: string };

const heroShots: Shot[] = [
  {
    id: "hero-timeline",
    title: "The timeline",
    caption: "Every signal, on one chronological feed. Calendar entries, webhook alerts, monitoring events, your own scripts — all in the order they happened.",
  },
  {
    id: "hero-action-panel",
    title: "Actions in context",
    caption: "Each event carries its next move. Open a URL, run a command, copy a value, launch a dashboard — even jump into Todoist, Obsidian, or DEVONthink. One click from the row, no app-switching.",
  },
  {
    id: "hero-score-editor-ha",
    title: "Score Editor — Home Assistant",
    caption: "Teach Tempo how to read a new source. Severity rules, color, grouping, custom labels — all declarative, no code.",
  },
  {
    id: "hero-score-editor-unifi",
    title: "Score Editor — UniFi",
    caption: "Dense rule sets handle the long tail of alarm classes. The editor scales to every flavor of source you throw at it.",
  },
  {
    id: "hero-score-editor-synology",
    title: "Score Editor — Synology",
    caption: "Same surface, simpler source. Each score is shaped to what its tool emits — no one-size-fits-all template.",
  },
  {
    id: "hero-light-theme",
    title: "Light theme",
    caption: "Same Tempo, lighter palette. Match your workspace — dark for the homelab cave, light for the home office.",
  },
];

const settingsShots: Shot[] = [
  {
    id: "settings-interface",
    title: "Interface",
    caption: "Theme, app icon, agenda visibility, system status footer — the surface-level knobs you tune first.",
  },
  {
    id: "settings-agenda",
    title: "Agenda",
    caption: "What flows in from Apple Calendar and Reminders — which calendars, which list, how far ahead.",
  },
  {
    id: "settings-ingestion",
    title: "Ingestion",
    caption: "Tokens, ports, the LAN binding. Everything a sender needs to reach Tempo over HTTP.",
  },
  {
    id: "settings-maintenance",
    title: "Maintenance",
    caption: "Auto-dismiss per source, cleanup windows, backup schedule, database retention.",
  },
];

const homelabScenarios: Shot[] = [
  {
    id: "homelab-kuma-down",
    title: "Uptime Kuma — host recovered",
    caption: "Kuma POSTs the recovery as soon as the monitor goes back up, Tempo flags it green. Action panel offers Open in Kuma to inspect the dashboard, ping the host, and copy the monitor URL.",
  },
  {
    id: "homelab-unifi-connect",
    title: "UniFi — device flapping, stacked",
    caption: "When a device disconnects and reconnects repeatedly, Tempo collapses the noise into a single stack on the timeline — count visible at a glance, full sequence one click away. Same row stays under the UniFi parent in the source panel.",
  },
  {
    id: "homelab-kopia-complete",
    title: "Kopia — backup complete",
    caption: "Snapshot finished, size and duration in the row. Action to open the repository in Finder or copy the snapshot ID for scripting.",
  },
  {
    id: "homelab-ha-scene",
    title: "Home Assistant — automation finished",
    caption: "HA fires a webhook when a scene runs. Tempo records it next to today's other events; action button triggers the inverse scene if you change your mind.",
  },
];

const wfhScenarios: Shot[] = [
  {
    id: "wfh-meeting-cross-source",
    title: "Meeting starting — URLs auto-extracted",
    caption: "Calendar event with URLs in the notes — Tempo extracts them automatically as action buttons. One click jumps to the Todoist task, the Obsidian note, the DEVONthink doc, or the meeting link in the browser. Zero configuration: the publisher of the feed put the links there, Tempo just surfaces them.",
  },
  {
    id: "wfh-scan-from-mfp",
    title: "Scan from the multifunction printer",
    caption: "Hazel watches the scanner folder. New PDF lands, Hazel POSTs to Tempo with the filename. Actions: open in Preview, move to the tax folder, email to the bookkeeper.",
  },
  {
    id: "wfh-delivery",
    title: "Delivery — out for arrival",
    caption: "Carrier email arrives. A Mail rule + Hazel script extracts the tracking number and POSTs to Tempo. Action panel opens the carrier's tracking page directly so you can see the status without digging through email, plus copy the tracking number.",
  },
  {
    id: "wfh-keepa-pricedrop",
    title: "Keepa — price drop on a watched product",
    caption: "Keepa sends its free email alert when a wishlist item drops below your threshold. A Mail rule forwards it to Tempo via Hazel. Action panel opens the Amazon page so you can pull the trigger or pass.",
  },
];

const allShots: Shot[] = [
  ...heroShots,
  ...settingsShots,
  ...homelabScenarios,
  ...wfhScenarios,
];
---
<BaseLayout
  title="Gallery — Tempo"
  description="What Tempo looks like, and a few examples of what people use it for — homelab monitoring, work-from-home triage, and the in-between."
>
  <header class="gallery-header">
    <h1>Gallery</h1>
    <p class="lede">
      Tempo in action — pick your theme, then watch your events roll in.
    </p>
  </header>

  <section class="hero-shots">
    {heroShots.map((shot) => (
      <figure class="hero-card">
        <a href={`#${shot.id}`} class="shot-thumb" aria-label={`Open ${shot.title} fullscreen`}>
          <img src={`/gallery/${shot.id}.png`} alt={shot.title} loading="lazy" />
        </a>
        <figcaption>
          <h3>{shot.title}</h3>
          <p>{shot.caption}</p>
        </figcaption>
      </figure>
    ))}
  </section>

  <section class="customize-note">
    <p>
      All the visualization choices are customizable in the Score Editor.
      Every action can be customized (or you can add more) by editing the
      <a href="/docs/11-score-authoring/#defaultactions">score's JSON file</a>
      (for the moment...)
    </p>
  </section>

  <section class="scenario-section" aria-labelledby="make-it-yours">
    <header class="scenario-header">
      <span class="scenario-chip">Make it yours</span>
      <h2 id="make-it-yours">A look at some of the settings</h2>
      <p class="scenario-intro">
        A look at some of the settings... Tempo's meant to be a
        made-to-measure tool, this is a taste of the knobs.
      </p>
    </header>
    <div class="settings-grid">
      {settingsShots.map((s) => (
        <figure class="scenario-card">
          <a href={`#${s.id}`} class="shot-thumb" aria-label={`Open ${s.title} fullscreen`}>
            <img src={`/gallery/${s.id}.png`} alt={s.title} loading="lazy" />
          </a>
          <figcaption>
            <h3>{s.title}</h3>
            <p>{s.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="disclaimer">
    <p>
      Tempo adapts to your needs. Below are a few examples by environment...
      they're just examples. Tempo can show everything, or just what you need
      at the moment.
    </p>
  </section>

  <section class="scenario-section" aria-labelledby="for-homelab">
    <header class="scenario-header">
      <span class="scenario-chip">For homelab</span>
      <h2 id="for-homelab">Webhooks, monitoring, infrastructure</h2>
      <p class="scenario-intro">
        Tempo aggregates the signals your digital life already throws off:
        Uptime Kuma, UniFi, your backup system, Pi-hole, Proxmox, your house
        via Home Assistant, GitHub, your own scripts. Everything lands on one
        Mac-native timeline, with the next move one click from the row — and
        you can customize the buttons too. No new dashboards, no logging in
        to check status. Apple Calendar and Reminders flow in alongside,
        ready to show your day at a glance.
      </p>
    </header>
    <div class="scenario-grid">
      {homelabScenarios.map((s) => (
        <figure class="scenario-card">
          <a href={`#${s.id}`} class="shot-thumb" aria-label={`Open ${s.title} fullscreen`}>
            <img src={`/gallery/${s.id}.png`} alt={s.title} loading="lazy" />
          </a>
          <figcaption>
            <h3>{s.title}</h3>
            <p>{s.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="scenario-section" aria-labelledby="for-wfh">
    <header class="scenario-header">
      <span class="scenario-chip">For home office</span>
      <h2 id="for-wfh">Meetings, errands, the desk you actually sit at</h2>
      <p class="scenario-intro">
        Work-from-home has its own rhythm — meetings that need focus, a
        printer-scanner you wish would tell you when it's done, deliveries
        that interrupt the day, small purchases you've been waiting on. Many
        of the tools involved don't speak webhooks natively, so Tempo gets
        them through small bridges — Hazel rules, Mail rules, Apple
        Shortcuts. The same timeline, just wired to a different stack.
      </p>
    </header>
    <div class="scenario-grid">
      {wfhScenarios.map((s) => (
        <figure class="scenario-card">
          <a href={`#${s.id}`} class="shot-thumb" aria-label={`Open ${s.title} fullscreen`}>
            <img src={`/gallery/${s.id}.png`} alt={s.title} loading="lazy" />
          </a>
          <figcaption>
            <h3>{s.title}</h3>
            <p>{s.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <aside class="callout">
      <p>
        These three are Hazel rules, but Hazel is one bridge among many.
        I picked these because I love Hazel and use it daily; Hazel can
        watch any folder, any file pattern, any download. If Hazel or any
        tool like it sees it, Tempo can show it and act on it. The three
        above are where I started, not where I stopped.
      </p>
    </aside>
  </section>

  <section class="scenario-section coming">
    <header class="scenario-header">
      <span class="scenario-chip muted">More coming</span>
      <h2>For knowledge workers, for multimedia creators</h2>
      <p class="scenario-intro">
        Notes, drafts, editorial deadlines on one side; OBS scene changes,
        Frame.io reviews, render queues on the other. We'll add both
        environments here in the weeks after launch. If your stack doesn't
        fit any of these labels, that's fine too — point it at Tempo and
        it'll find a row.
      </p>
    </header>
  </section>

  <section class="whats-next" aria-labelledby="whats-next">
    <h2 id="whats-next">What's next</h2>
    <ul class="whats-next-list">
      <li><strong>Apple Shortcuts + Automator integration</strong> <em>(any genre, every tempo)</em></li>
      <li><strong>In-app score browser</strong> — install scores from inside Tempo</li>
      <li><strong>Time Machine</strong>, built-in</li>
      <li><strong>Timeline filtering</strong> — show all events, or only those needing attention</li>
      <li><strong>More theme presets</strong></li>
      <li><strong>Sound customization</strong> — drop-in your own</li>
      <li><strong>Map preview</strong> for Calendar events with locations</li>
      <li>
        <strong>More scores</strong>, grouped by where they live in your stack:
        <ul class="whats-next-sub">
          <li><em>Homelab &amp; infra:</em> Tailscale, Grafana, TrueNAS, pfSense / OPNsense, AdGuard Home, Portainer, qBittorrent</li>
          <li><em>Media:</em> Sonarr, Radarr, Lidarr, Plex, Kodi</li>
          <li><em>Self-hosted apps:</em> Nextcloud, Gitea / Forgejo, GitLab, Paperless-ngx, Immich</li>
          <li><em>Mac power-user tools:</em> Keyboard Maestro, Alfred, Raycast</li>
          <li><em>DIY / IoT:</em> Arduino + ESP32 recipes</li>
        </ul>
      </li>
    </ul>
    <p class="whats-next-trailing"><em>...and much more to come.</em></p>
    <p class="whats-next-link">
      Full roadmap, with detail and rationale, at <a href="/roadmap">/roadmap</a>.
    </p>
  </section>

  <footer class="gallery-footer">
    <p>
      Ready to try it on your own stack? <a href="/downloads">Download Tempo</a>
      — or read the <a href="/docs/">docs</a> first to see what a score looks
      like.
    </p>
  </footer>

  <!-- Lightbox overlays. CSS-only :target pattern, no JS. -->
  {allShots.map((s) => (
    <div id={s.id} class="lightbox" role="dialog" aria-modal="true" aria-label={s.title}>
      <a href="#_" class="lightbox-bg" aria-label="Close"></a>
      <div class="lightbox-frame">
        <img class="lightbox-img" src={`/gallery/${s.id}.png`} alt={s.title} />
        <a href="#_" class="lightbox-close" aria-label="Close">×</a>
      </div>
    </div>
  ))}
</BaseLayout>

<style>
  /* Layout — wider than the article measure to host 3-up hero and 2×2 scenario grids */
  .gallery-header,
  .hero-shots,
  .customize-note,
  .disclaimer,
  .scenario-section,
  .whats-next,
  .gallery-footer {
    max-width: 960px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .gallery-header {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }
  .gallery-header h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .gallery-header .lede {
    color: var(--text2);
    max-width: 60ch;
    margin-bottom: 0.75rem;
  }

  /* Hero shots — 3 across on desktop, stacked on mobile. With 6 cards
     this naturally arranges as a 3×2 grid above 820px. */
  .hero-shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
  .hero-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .hero-card h3 {
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.25rem;
  }
  .hero-card p {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Customize note — yellow-tinted callout between hero and Make it yours.
     Obsidian-style: fully rounded corners + soft all-around border + bg tint.
     Less rigid than a left-rule callout, sits more like a pill in the
     rhythm of the otherwise rectilinear sections above and below. */
  .customize-note {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    background: rgba(201, 162, 39, 0.08);
    border: 1px solid rgba(201, 162, 39, 0.32);
  }
  .customize-note p {
    color: #d4a833;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .customize-note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(212, 168, 51, 0.5);
    text-underline-offset: 3px;
  }
  .customize-note a:hover {
    text-decoration-color: #d4a833;
  }

  /* Disclaimer — italic-ish callout band */
  .disclaimer {
    padding-top: 1rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
    margin-top: 1rem;
  }
  .disclaimer p {
    color: var(--text2);
    max-width: 60ch;
    font-size: 0.95rem;
  }
  .disclaimer strong { color: var(--text); }

  /* Scenario + Settings sections */
  .scenario-section {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .scenario-section.coming {
    opacity: 0.7;
  }
  .scenario-header {
    margin-bottom: 1.75rem;
  }
  .scenario-chip {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--text2);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .scenario-chip.muted {
    color: var(--text3);
  }
  .scenario-header h2 {
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }
  .scenario-intro {
    color: var(--text2);
    max-width: 60ch;
    line-height: 1.6;
  }

  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  /* Settings grid — 4 across so settings shots stay visually smaller
     than the wide Tempo timeline screenshots in the scenario sections.
     Settings PNGs are near-square (~1488×1624) vs timeline shots wide
     (~3872×2388); a 2-col layout was making settings appear "larger"
     because of vertical bulk. 4-col solves that without cropping. */
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .scenario-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .scenario-card h3 {
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.25rem;
  }
  .scenario-card p {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Callout — Hazel "via artificio" note after WFH cards.
     Obsidian-style rounded pill, parallel to the customize-note above.
     Blue-tinted instead of yellow because this is narrative context,
     not the meta-emphasis of the customize note. */
  .callout {
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    background: rgba(10, 132, 255, 0.08);
    border: 1px solid rgba(10, 132, 255, 0.32);
  }
  .callout p {
    color: var(--text2);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Shot thumbnails — link to lightbox via :target */
  .shot-thumb {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg2);
    transition: border-color 120ms ease, transform 120ms ease;
    cursor: zoom-in;
  }
  .shot-thumb:hover {
    border-color: var(--text3);
    text-decoration: none;
  }
  .shot-thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Lightbox overlay — CSS-only :target pattern */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(8, 8, 10, 0.94);
    z-index: 100;
    padding: 2rem;
    align-items: center;
    justify-content: center;
  }
  .lightbox:target {
    display: flex;
  }
  .lightbox-bg {
    position: absolute;
    inset: 0;
    cursor: default;
  }
  .lightbox-frame {
    position: relative;
    max-width: min(1200px, 95vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }
  .lightbox-img {
    position: relative;
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .lightbox-close {
    position: absolute;
    top: -0.5rem;
    right: 0;
    transform: translate(50%, -100%);
    color: var(--text);
    font-size: 1.75rem;
    line-height: 1;
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: rgba(20, 20, 22, 0.9);
    border: 1px solid var(--border);
    z-index: 2;
  }
  .lightbox-close:hover {
    color: var(--text);
    background: var(--bg2);
    text-decoration: none;
  }

  /* What's next — roadmap teaser */
  .whats-next {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .whats-next h2 {
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
  }
  .whats-next-list {
    list-style: disc;
    padding-left: 1.4rem;
    color: var(--text2);
    line-height: 1.7;
    max-width: 60ch;
  }
  .whats-next-list li {
    margin-bottom: 0.4rem;
  }
  .whats-next-list strong {
    color: var(--text);
    font-weight: 500;
  }
  .whats-next-list em {
    color: var(--text3);
    font-style: italic;
  }
  .whats-next-sub {
    list-style: circle;
    padding-left: 1.2rem;
    margin-top: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .whats-next-sub li {
    margin-bottom: 0.25rem;
  }
  .whats-next-sub em {
    color: var(--text2);
    font-style: italic;
  }
  .whats-next-trailing {
    color: var(--text3);
    font-style: italic;
    margin-top: 1.25rem;
    max-width: 60ch;
  }
  .whats-next-link {
    color: var(--text2);
    margin-top: 0.75rem;
    max-width: 60ch;
  }
  .whats-next-link a { color: var(--blue); }

  /* Footer */
  .gallery-footer {
    padding-top: 2rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--border);
    color: var(--text3);
    font-size: 0.95rem;
  }
  .gallery-footer a { color: var(--blue); }

  /* Responsive */
  @media (max-width: 820px) {
    .hero-shots {
      grid-template-columns: 1fr;
    }
    .scenario-grid {
      grid-template-columns: 1fr;
    }
    .settings-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
