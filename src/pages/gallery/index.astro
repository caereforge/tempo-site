---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Each shot: id (for lightbox anchor + filename slug), title, caption.
// Screenshots live in /public/gallery/<id>.png
type Shot = { id: string; title: string; caption: string };

const timelineThemes: Shot[] = [
  {
    id: "timeline-caereforge",
    title: "Caereforge theme",
    caption: "Every signal on one chronological feed: calendar entries, webhook alerts, monitoring events, your own scripts, in the order they happened. The signature Caereforge palette, made for long sessions.",
  },
  {
    id: "timeline-dark",
    title: "Dark theme",
    caption: "The same timeline in classic dark. For the homelab cave, late nights, and screens that stay on.",
  },
  {
    id: "timeline-light",
    title: "Light theme",
    caption: "Same Tempo, lighter palette. For the home office and bright rooms. Pick the look that matches your desk.",
  },
];

const noAgendaShots: Shot[] = [
  { id: "timeline-caereforge-no-agenda", title: "Caereforge, agenda off", caption: "" },
  { id: "timeline-dark-no-agenda", title: "Dark, agenda off", caption: "" },
  { id: "timeline-light-no-agenda", title: "Light, agenda off", caption: "" },
];

const editorTabs: Shot[] = [
  {
    id: "editor-source",
    title: "Source",
    caption: "Name, color, and the provider the score binds to. The identity of the source in the panel and the feed.",
  },
  {
    id: "editor-severity",
    title: "Severity",
    caption: "Map each payload to a severity and a custom label. The same outcome can be a warning for you and critical for someone else.",
  },
  {
    id: "editor-grouping",
    title: "Grouping",
    caption: "Collapse repeats into one stack: choose the key and the window. A chatty monitor stops flooding the feed.",
  },
  {
    id: "editor-actions",
    title: "Actions",
    caption: "The buttons each event carries. Open a URL, run a command, copy a value, all interpolated from the payload at click time.",
  },
  {
    id: "editor-tags",
    title: "Tags & Emoji",
    caption: "Tag events and pick the indicator emoji, so a source reads at a glance without opening it.",
  },
  {
    id: "editor-ack-dismiss",
    title: "Ack & Dismiss",
    caption: "Rules for auto-acknowledging and auto-dismissing, so routine noise clears itself and only what matters stays.",
  },
];

const searchShot: Shot = {
  id: "search",
  title: "Search",
  caption: "Find any event by title, metadata, or source, across your whole history, not just what's on screen.",
};

const heatmapShots: Shot[] = [
  {
    id: "heatmap-historical",
    title: "Historical heatmap",
    caption: "Sits at the bottom of the source panel. Shows an 84-day window, useful for spotting patterns and busy days at a glance.",
  },
  {
    id: "heatmap-daily",
    title: "Daily heatmap",
    caption: "Doubles as a day picker and divider. Shows the highest-severity event for each hour of the day, so nothing critical gets buried when the feed runs long.",
  },
];

const settingsShots: Shot[] = [
  {
    id: "settings-interface",
    title: "Interface",
    caption: "Theme, app icon, agenda visibility, system status footer: the surface-level knobs you tune first.",
  },
  {
    id: "settings-agenda",
    title: "Agenda",
    caption: "What flows in from Apple Calendar and Reminders: which calendars, which list, how far ahead.",
  },
  {
    id: "settings-ingestion",
    title: "Ingestion",
    caption: "Tokens, ports, the LAN binding. Everything a sender needs to reach Tempo over HTTP.",
  },
  {
    id: "settings-maintenance",
    title: "Maintenance",
    caption: "Auto-dismiss per source, cleanup windows, backup schedule, database retention.",
  },
];

const allShots: Shot[] = [
  ...timelineThemes,
  ...noAgendaShots,
  ...editorTabs,
  searchShot,
  ...heatmapShots,
  ...settingsShots,
];
---
<BaseLayout
  title="Gallery - Tempo"
  description="What Tempo looks like: the timeline in three themes, the Score Editor up close, search, and the settings you tune to make it yours."
>
  <header class="gallery-header">
    <h1>Gallery</h1>
    <p class="lede">
      Tempo in action: pick your theme, then watch your events roll in.
    </p>
  </header>

  <section class="hero-shots">
    {timelineThemes.map((shot) => (
      <figure class="hero-card">
        <a href={`#${shot.id}`} class="shot-thumb" aria-label={`Open ${shot.title} fullscreen`}>
          <img src={`/gallery/${shot.id}.png`} alt={shot.title} loading="lazy" />
        </a>
        <figcaption>
          <h3>{shot.title}</h3>
          <p>{shot.caption}</p>
        </figcaption>
      </figure>
    ))}
  </section>

  <section class="scenario-section" aria-labelledby="agenda-off">
    <header class="scenario-header">
      <span class="scenario-chip">Your call</span>
      <h2 id="agenda-off">Calendar in, or calendar out</h2>
      <p class="scenario-intro">
        Apple Calendar and Reminders flow in alongside everything else, ready
        to show your day. Not your thing? Hide the agenda and Tempo is a pure
        event feed, just your sources, nothing else. Same three themes.
      </p>
    </header>
    <div class="hero-shots tight">
      {noAgendaShots.map((shot) => (
        <figure class="hero-card">
          <a href={`#${shot.id}`} class="shot-thumb" aria-label={`Open ${shot.title} fullscreen`}>
            <img src={`/gallery/${shot.id}.png`} alt={shot.title} loading="lazy" />
          </a>
          <figcaption>
            <h3>{shot.title}</h3>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="scenario-section" aria-labelledby="score-editor">
    <header class="scenario-header">
      <span class="scenario-chip">Make a source yours</span>
      <h2 id="score-editor">The Score Editor, tab by tab</h2>
      <p class="scenario-intro">
        A score teaches Tempo how to read a source: how to color it, when to
        raise the severity, how to group repeats, which actions to offer. The
        editor walks every part of it, no JSON required (though the JSON stays
        the source of truth if you prefer to hand-edit).
      </p>
    </header>
    <div class="hero-shots">
      {editorTabs.map((shot) => (
        <figure class="hero-card">
          <a href={`#${shot.id}`} class="shot-thumb" aria-label={`Open ${shot.title} fullscreen`}>
            <img src={`/gallery/${shot.id}.png`} alt={shot.title} loading="lazy" />
          </a>
          <figcaption>
            <h3>{shot.title}</h3>
            <p>{shot.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="customize-note">
    <p>
      Every visualization choice and every action is editable in the Score
      Editor, or by hand in the
      <a href="/docs/11-score-authoring/#defaultactions">score's JSON file</a>.
      Each bundled score also has its own page in the
      <a href="/scores">catalogue</a>, with a screenshot of that source on the
      Tempo timeline.
    </p>
  </section>

  <section class="scenario-section" aria-labelledby="search">
    <header class="scenario-header">
      <span class="scenario-chip">Find anything</span>
      <h2 id="search">Search across everything</h2>
      <p class="scenario-intro">{searchShot.caption}</p>
    </header>
    <figure class="single-card">
      <a href={`#${searchShot.id}`} class="shot-thumb" aria-label={`Open ${searchShot.title} fullscreen`}>
        <img src={`/gallery/${searchShot.id}.png`} alt={searchShot.title} loading="lazy" />
      </a>
    </figure>
  </section>

  <section class="scenario-section" aria-labelledby="patterns-over-time">
    <header class="scenario-header">
      <span class="scenario-chip">Patterns over time</span>
      <h2 id="patterns-over-time">Two heatmaps, two time scales</h2>
      <p class="scenario-intro">
        Tempo has two distinct heatmaps. Both surface insights on the
        activity Tempo ingests at a glance, each with a different time scale.
      </p>
    </header>
    <div class="heatmap-grid">
      <figure class="heatmap-card hist">
        <a href="#heatmap-historical" class="shot-thumb" aria-label="Open Historical heatmap fullscreen">
          <img src="/gallery/heatmap-historical.png" alt="Historical heatmap" loading="lazy" />
        </a>
      </figure>
      <div class="heatmap-caption">
        <h3>Historical heatmap</h3>
        <p>Sits at the bottom of the source panel. Shows an 84-day window, useful for spotting patterns and busy days at a glance.</p>
      </div>
      <figure class="heatmap-card daily-full">
        <a href="#heatmap-daily" class="shot-thumb" aria-label="Open Daily heatmap fullscreen">
          <img src="/gallery/heatmap-daily.png" alt="Daily heatmap" loading="lazy" />
        </a>
        <figcaption>
          <h3>Daily heatmap</h3>
          <p>Doubles as a day picker and divider. Shows the highest-severity event for each hour of the day, so nothing critical gets buried when the feed runs long.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="scenario-section" aria-labelledby="make-it-yours">
    <header class="scenario-header">
      <span class="scenario-chip">Make it yours</span>
      <h2 id="make-it-yours">A look at some of the settings</h2>
      <p class="scenario-intro">
        A look at some of the settings... Tempo's meant to be a
        made-to-measure tool, this is a taste of the knobs.
      </p>
    </header>
    <div class="settings-grid">
      {settingsShots.map((s) => (
        <figure class="scenario-card">
          <a href={`#${s.id}`} class="shot-thumb" aria-label={`Open ${s.title} fullscreen`}>
            <img src={`/gallery/${s.id}.png`} alt={s.title} loading="lazy" />
          </a>
          <figcaption>
            <h3>{s.title}</h3>
            <p>{s.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="whats-next" aria-labelledby="whats-next">
    <h2 id="whats-next">What's next</h2>
    <ul class="whats-next-list">
      <li><strong>Apple Shortcuts + Automator integration</strong> <em>(any genre, every tempo)</em></li>
      <li><strong>In-app score browser</strong>: install scores from inside Tempo</li>
      <li><strong>Time Machine</strong>, built-in</li>
      <li><strong>Timeline filtering</strong>: show all events, or only those needing attention</li>
      <li><strong>More theme presets</strong></li>
      <li><strong>Sound customization</strong>: drop-in your own</li>
      <li><strong>Map preview</strong> for Calendar events with locations</li>
      <li>
        <strong>More scores</strong>, grouped by where they live in your stack:
        <ul class="whats-next-sub">
          <li><em>Homelab &amp; infra:</em> Tailscale, Grafana, TrueNAS, pfSense / OPNsense, AdGuard Home, Portainer, qBittorrent</li>
          <li><em>Media:</em> Sonarr, Radarr, Lidarr, Plex, Kodi</li>
          <li><em>Self-hosted apps:</em> Nextcloud, Gitea / Forgejo, GitLab, Paperless-ngx, Immich</li>
          <li><em>Mac power-user tools:</em> Keyboard Maestro, Alfred, Raycast</li>
          <li><em>DIY / IoT:</em> Arduino + ESP32 recipes</li>
        </ul>
      </li>
    </ul>
    <p class="whats-next-trailing"><em>...and much more to come.</em></p>
    <p class="whats-next-link">
      Full roadmap, with detail and rationale, at <a href="/roadmap">/roadmap</a>.
    </p>
  </section>

  <footer class="gallery-footer">
    <p>
      Try it on your own stack. <a href="/downloads">Download Tempo</a>,
      or read the <a href="/docs/">docs</a> first to see what a score looks
      like.
    </p>
  </footer>

  <!-- Lightbox overlays. CSS-only :target pattern, no JS. -->
  {allShots.map((s) => (
    <div id={s.id} class="lightbox" role="dialog" aria-modal="true" aria-label={s.title}>
      <a href="#_" class="lightbox-bg" aria-label="Close"></a>
      <div class="lightbox-frame">
        <img class="lightbox-img" src={`/gallery/${s.id}.png`} alt={s.title} />
        <a href="#_" class="lightbox-close" aria-label="Close">×</a>
      </div>
    </div>
  ))}
</BaseLayout>

<style>
  /* Layout - wider than the article measure to host 3-up hero grids */
  .gallery-header,
  .hero-shots,
  .customize-note,
  .scenario-section,
  .whats-next,
  .gallery-footer {
    max-width: 960px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .gallery-header {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }
  .gallery-header h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .gallery-header .lede {
    color: var(--text2);
    max-width: 60ch;
    margin-bottom: 0.75rem;
  }

  /* Hero shots - 3 across on desktop, stacked on mobile. Reused for the
     timeline themes, the no-agenda variants, and the Score Editor tabs. */
  .hero-shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
  .hero-shots.tight {
    padding-bottom: 0;
  }
  .hero-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .hero-card h3 {
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.25rem;
  }
  .hero-card p {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Single centered shot (Search) */
  .single-card {
    margin: 0 auto;
    max-width: 720px;
  }

  /* Customize note - yellow-tinted callout */
  .customize-note {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    background: rgba(201, 162, 39, 0.08);
    border: 1px solid rgba(201, 162, 39, 0.32);
  }
  .customize-note p {
    color: #d4a833;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .customize-note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(212, 168, 51, 0.5);
    text-underline-offset: 3px;
  }
  .customize-note a:hover {
    text-decoration-color: #d4a833;
  }

  /* Scenario + Settings sections */
  .scenario-section {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .scenario-header {
    margin-bottom: 1.75rem;
  }
  .scenario-chip {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--text2);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .scenario-header h2 {
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }
  .scenario-intro {
    color: var(--text2);
    max-width: 60ch;
    line-height: 1.6;
  }

  /* Heatmap grid - asymmetric */
  .heatmap-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    align-items: start;
  }
  .heatmap-card {
    margin: 0;
  }
  .heatmap-card.daily-full {
    grid-column: 1 / -1;
    max-width: 672px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .heatmap-card.daily-full .shot-thumb {
    padding: 0.5rem 0;
  }
  .heatmap-card.daily-full .shot-thumb img {
    width: 80%;
    height: auto;
    display: block;
  }
  .heatmap-caption {
    align-self: center;
  }
  .heatmap-caption h3 {
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.5rem;
  }
  .heatmap-caption p {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .heatmap-card .shot-thumb img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .heatmap-card.hist {
    max-width: 220px;
  }
  .heatmap-card.hist .shot-thumb {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
  }
  .heatmap-card.hist .shot-thumb img {
    max-width: 150px;
    height: auto;
  }
  .heatmap-card.daily-full h3 {
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.25rem;
  }
  .heatmap-card.daily-full figcaption p {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 75ch;
  }

  /* Settings grid - 4 across so settings shots stay visually smaller */
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .scenario-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .scenario-card h3 {
    font-size: 1rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.25rem;
  }
  .scenario-card p {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Shot thumbnails - link to lightbox via :target */
  .shot-thumb {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg2);
    transition: border-color 120ms ease, transform 120ms ease;
    cursor: zoom-in;
  }
  .shot-thumb:hover {
    border-color: var(--text3);
    text-decoration: none;
  }
  .shot-thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Lightbox overlay - CSS-only :target pattern */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(8, 8, 10, 0.94);
    z-index: 100;
    padding: 2rem;
    align-items: center;
    justify-content: center;
  }
  .lightbox:target {
    display: flex;
  }
  .lightbox-bg {
    position: absolute;
    inset: 0;
    cursor: default;
  }
  .lightbox-frame {
    position: relative;
    max-width: min(1200px, 95vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }
  .lightbox-img {
    position: relative;
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .lightbox-close {
    position: absolute;
    top: -0.5rem;
    right: 0;
    transform: translate(50%, -100%);
    color: var(--text);
    font-size: 1.75rem;
    line-height: 1;
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: rgba(20, 20, 22, 0.9);
    border: 1px solid var(--border);
    z-index: 2;
  }
  .lightbox-close:hover {
    color: var(--text);
    background: var(--bg2);
    text-decoration: none;
  }

  /* What's next - roadmap teaser */
  .whats-next {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .whats-next h2 {
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
  }
  .whats-next-list {
    list-style: disc;
    padding-left: 1.4rem;
    color: var(--text2);
    line-height: 1.7;
    max-width: 60ch;
  }
  .whats-next-list li {
    margin-bottom: 0.4rem;
  }
  .whats-next-list strong {
    color: var(--text);
    font-weight: 500;
  }
  .whats-next-list em {
    color: var(--text3);
    font-style: italic;
  }
  .whats-next-sub {
    list-style: circle;
    padding-left: 1.2rem;
    margin-top: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .whats-next-sub li {
    margin-bottom: 0.25rem;
  }
  .whats-next-sub em {
    color: var(--text2);
    font-style: italic;
  }
  .whats-next-trailing {
    color: var(--text3);
    font-style: italic;
    margin-top: 1.25rem;
    max-width: 60ch;
  }
  .whats-next-link {
    color: var(--text2);
    margin-top: 0.75rem;
    max-width: 60ch;
  }
  .whats-next-link a { color: var(--blue); }

  /* Footer */
  .gallery-footer {
    padding-top: 2rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--border);
    color: var(--text3);
    font-size: 0.95rem;
  }
  .gallery-footer a { color: var(--blue); }

  /* Responsive */
  @media (max-width: 820px) {
    .hero-shots {
      grid-template-columns: 1fr;
    }
    .settings-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .heatmap-grid {
      grid-template-columns: 1fr;
    }
    .heatmap-card.daily-full {
      grid-column: auto;
    }
  }
  @media (max-width: 520px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
