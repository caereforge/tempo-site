---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const tips = (await getCollection("tips", ({ data }) => !data.draft))
  .slice()
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Tips & Tricks - Tempo"
  description="Short, practical tips for getting more out of Tempo: clever uses, best practices, and gotchas, beyond the reference docs."
>
  <header class="page-header">
    <p class="page-nav"><a href="/docs">← Documentation</a></p>
    <h1>Tips &amp; Tricks</h1>
    <p class="lede">
      Short, practical things you can do with Tempo, beyond the reference
      docs. The user guide tells you how a feature works; these tell you how
      to use it well, the clever uses, the small habits, and the gotchas.
    </p>
  </header>

  <main class="doc">
    <ul class="cards">
      {tips.map((t) => (
        <li class="card">
          <a href={`/tips/${t.id}`}>
            {t.data.category && <span class="cat">{t.data.category}</span>}
            <h3>{t.data.title}</h3>
            <p>{t.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .page-header {
      max-width: 760px;
      margin: 48px auto 24px;
      padding: 0 24px;
      font-family: var(--font-sans);
      color: var(--text);
    }
    .page-nav {
      font-size: 14px;
      margin-bottom: 24px;
    }
    .page-nav a {
      color: var(--blue);
      text-decoration: none;
    }
    .page-header h1 {
      font-size: 36px;
      margin: 0 0 16px;
      color: var(--text);
    }
    .lede {
      font-size: 17px;
      line-height: 1.65;
      color: var(--text);
      padding: 16px 20px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 16px;
    }
    .doc {
      max-width: 760px;
      margin: 0 auto 80px;
      padding: 0 24px;
      font-family: var(--font-sans);
      line-height: 1.65;
      color: var(--text);
    }
    .cards {
      list-style: none;
      padding: 0;
      margin: 16px 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .card {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg2);
      transition: border-color 0.15s ease;
    }
    .card:hover {
      border-color: var(--blue);
    }
    .card a {
      display: block;
      padding: 16px 20px;
      text-decoration: none;
      color: var(--text);
    }
    .card .cat {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text3, var(--text2));
      margin-bottom: 8px;
    }
    .card h3 {
      margin: 0 0 8px;
      font-size: 17px;
      color: var(--text);
    }
    .card p {
      margin: 0;
      color: var(--text2);
      font-size: 14px;
      line-height: 1.5;
    }
  </style>
</BaseLayout>
