---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const guideChapters = (await getCollection("userguide", ({ data }) => !data.draft))
  .slice()
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Docs — Tempo"
  description="Documentation for Tempo: per-source integration guides, reference pages, and the upcoming Tempo user guide."
>
  <header class="page-header">
    <nav class="page-nav">
      <a href="/">← tempoapp.app</a>
    </nav>
    <h1>Documentation</h1>
    <p class="lede">
      Tempo's docs split into three areas. Per-source integration guides
      live on each score's own page in the catalogue, alongside the
      download. Cross-source reference pages live here. A full Tempo user
      guide will land here once v1 ships and the rough edges are polished.
    </p>
  </header>

  <main class="doc">

    <section class="group">
      <h2>Per-source integration guides</h2>
      <p>
        For setting up a specific source — Home Assistant, Kopia, Uptime
        Kuma, UniFi, GitHub Actions, Synology, Pi-hole, Proxmox, Hazel,
        Jellyfin, Vaultwarden, and more — open the score's catalogue page.
        Each one documents the source-side configuration, the payload
        contract Tempo expects, and what the bundled severity rules and
        actions look for.
      </p>
      <ul class="cards">
        <li class="card">
          <a href="/scores">
            <h3>Browse the scores catalogue →</h3>
            <p>
              Bundled and community scores. Double-click a
              <code>.tempo-score</code> to install, or read the page for
              the integration walkthrough.
            </p>
          </a>
        </li>
      </ul>
    </section>

    <section class="group">
      <h2>Reference</h2>
      <ul class="cards">
        <li class="card">
          <a href="/scores/troubleshooting-networking">
            <h3>Troubleshooting networking</h3>
            <p>
              When the score is installed and the source is configured,
              but events never reach Tempo. Five patterns that cover
              almost every reported case: firewall, Little Snitch, VLAN
              isolation, hostname resolution, port collision.
            </p>
          </a>
        </li>
      </ul>
    </section>

    <section class="group">
      <h2>Tempo user guide</h2>
      <p>
        The full guide covers Tempo end-to-end — what it is, how to set it
        up, every panel and setting, the Score Editor, troubleshooting, and
        a glossary. Start with chapter 1 if you're new, or jump straight
        to the chapter you need.
      </p>
      <ol class="chapter-list">
        {guideChapters.map((c) => (
          <li>
            <a href={`/docs/${c.id}`}>
              <span class="num">{String(c.data.chapter).padStart(2, "0")}</span>
              <span class="title">{c.data.title}</span>
              <span class="desc">{c.data.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="group">
      <h2>Got stuck?</h2>
      <p>
        Email <a href="mailto:hello@tempoapp.app">hello@tempoapp.app</a>.
        A community Discord and a public issue tracker open with the v1
        release; both will be linked here and on the homepage when they
        go live.
      </p>
    </section>

  </main>

  <style>
    .page-header {
      max-width: 760px;
      margin: 48px auto 24px;
      padding: 0 24px;
      font-family: var(--font-sans);
      color: var(--text);
    }
    .page-nav {
      font-size: 14px;
      margin-bottom: 24px;
    }
    .page-nav a {
      color: var(--blue);
      text-decoration: none;
    }
    .page-header h1 {
      font-size: 36px;
      margin: 0 0 16px;
      color: var(--text);
    }
    .lede {
      font-size: 17px;
      line-height: 1.65;
      color: var(--text);
      padding: 16px 20px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 16px;
    }
    .doc {
      max-width: 760px;
      margin: 0 auto 80px;
      padding: 0 24px;
      font-family: var(--font-sans);
      line-height: 1.65;
      color: var(--text);
    }
    .doc .group {
      margin-top: 48px;
    }
    .doc h2 {
      font-size: 22px;
      margin: 0 0 16px;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
    }
    .doc p {
      margin: 0 0 12px;
    }
    .doc a {
      color: var(--blue);
    }
    .cards {
      list-style: none;
      padding: 0;
      margin: 16px 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .card {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg2);
      transition: border-color 0.15s ease;
    }
    .card:hover {
      border-color: var(--blue);
    }
    .card a {
      display: block;
      padding: 16px 20px;
      text-decoration: none;
      color: var(--text);
    }
    .card h3 {
      margin: 0 0 8px;
      font-size: 17px;
      color: var(--text);
    }
    .card p {
      margin: 0;
      color: var(--text2);
      font-size: 14px;
      line-height: 1.5;
    }
    .chapter-list {
      list-style: none;
      padding: 0;
      margin: 16px 0 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .chapter-list li {
      margin: 0;
    }
    .chapter-list a {
      display: grid;
      grid-template-columns: 36px 1fr;
      grid-template-rows: auto auto;
      column-gap: 8px;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg2);
      text-decoration: none;
      color: var(--text);
      transition: border-color 0.15s ease;
    }
    .chapter-list a:hover {
      border-color: var(--blue);
    }
    .chapter-list .num {
      grid-row: 1 / span 2;
      align-self: start;
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--text3, var(--text2));
      padding-top: 2px;
    }
    .chapter-list .title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
    }
    .chapter-list .desc {
      font-size: 13px;
      color: var(--text2);
      line-height: 1.45;
      margin-top: 2px;
    }
    code {
      font-family: var(--font-mono);
      font-size: 0.9em;
      background: var(--bg2);
      padding: 2px 6px;
      border-radius: 4px;
      color: var(--text);
    }
  </style>
</BaseLayout>
