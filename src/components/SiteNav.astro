---
const pathname = Astro.url.pathname;
function isActive(prefix: string): boolean {
  if (prefix === "/") return pathname === "/";
  return pathname === prefix || pathname.startsWith(prefix + "/") || pathname === prefix.replace(/\/$/, "");
}
// Nav items mirror the homepage nav order so both surfaces look the
// same. Story and FAQ are anchors that route back to homepage sections
// — useful from any page to jump to the narrative pitch or FAQ.
const links: { href: string; label: string }[] = [
  { href: "/#story", label: "Story" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/#faq", label: "FAQ" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/downloads", label: "Downloads" },
  { href: "/scores/", label: "Scores" },
  { href: "/docs/", label: "Docs" },
  { href: "/blog/", label: "Blog" },
];
---
<header class="site-nav">
  <a class="site-nav-logo" href="/" aria-label="Tempo home">
    <svg class="site-nav-wordmark" viewBox="0 0 321 135.6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g transform="translate(4, 102.4) scale(1,-1)" fill="currentColor">
        <path d="M24 0V60.2H2.5V70H56.3V60.2H34.8V0Z"/>
        <path d="M30.2 -1.4Q22.7 -1.4 17.1 1.75Q11.5 4.9 8.35 10.65Q5.2 16.4 5.2 24V25.2Q5.2 32.9 8.3 38.65Q11.4 44.4 16.95 47.55Q22.5 50.7 29.8 50.7Q36.9 50.7 42.25 47.55Q47.6 44.4 50.6 38.8Q53.6 33.2 53.6 25.7V21.8H15.7Q15.9 15.3 20.05 11.45Q24.2 7.6 30.4 7.6Q36.2 7.6 39.15 10.2Q42.1 12.8 43.7 16.2L52.2 11.8Q50.8 9 48.15 5.9Q45.5 2.8 41.2 0.7Q36.9 -1.4 30.2 -1.4ZM15.8 29.7H43.1Q42.7 35.3 39.1 38.45Q35.5 41.6 29.7 41.6Q23.9 41.6 20.25 38.45Q16.6 35.3 15.8 29.7Z" transform="translate(55.3, 0)"/>
        <path d="M7.6 0V49.3H17.7V43.5H19.3Q20.7 46.1 23.8 48.1Q26.9 50.1 32.2 50.1Q37.7 50.1 41.05 47.85Q44.4 45.6 46.1 42.1H47.7Q49.4 45.5 52.65 47.8Q55.9 50.1 61.9 50.1Q66.7 50.1 70.4 48.15Q74.1 46.2 76.3 42.35Q78.5 38.5 78.5 32.8V0H68.2V32Q68.2 36.5 65.75 38.95Q63.3 41.4 58.8 41.4Q54 41.4 51.1 38.3Q48.2 35.2 48.2 29.4V0H37.9V32Q37.9 36.5 35.45 38.95Q33 41.4 28.5 41.4Q23.7 41.4 20.8 38.3Q17.9 35.2 17.9 29.4V0Z" transform="translate(110.2, 0)"/>
        <path d="M7.6 -20V49.3H17.7V42.2H19.3Q21.2 45.5 25.05 48.1Q28.9 50.7 36.1 50.7Q42.3 50.7 47.45 47.7Q52.6 44.7 55.75 39.05Q58.9 33.4 58.9 25.4V23.9Q58.9 15.9 55.8 10.25Q52.7 4.6 47.5 1.6Q42.3 -1.4 36.1 -1.4Q31.3 -1.4 28 -0.2Q24.7 1 22.7 2.85Q20.7 4.7 19.5 6.7H17.9V-20ZM33.1 7.6Q39.9 7.6 44.2 11.9Q48.5 16.2 48.5 24.2V25.1Q48.5 33 44.15 37.3Q39.8 41.6 33.1 41.6Q26.5 41.6 22.15 37.3Q17.8 33 17.8 25.1V24.2Q17.8 16.2 22.15 11.9Q26.5 7.6 33.1 7.6Z" transform="translate(192.4, 0)"/>
      </g>
      <circle cx="289" cy="75.1" r="28" fill="#D4795F"/>
      <circle cx="289" cy="75.1" r="15.12" fill="#9B2D1E"/>
    </svg>
  </a>
  <nav class="site-nav-links" aria-label="Primary">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={["site-nav-link", { active: isActive(link.href) }]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  /* Layout mirrors public/index.html: grid 1fr-auto-1fr keeps the logo
     left, the links optically centred, and a phantom right column that
     balances the logo so the link cluster sits in the middle of the
     viewport at every width — not pushed to the right as flex
     space-between would do. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 16px 40px;
  }

  .site-nav-logo {
    justify-self: start;
    display: flex;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }
  .site-nav-logo:hover { color: var(--text); text-decoration: none; }
  .site-nav-wordmark {
    height: 26px;
    width: auto;
    display: block;
  }

  .site-nav-links {
    grid-column: 2;
    justify-self: center;
    display: flex;
    gap: 4px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .site-nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--text2);
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 7px;
    white-space: nowrap;
    transition: color .15s, background .15s;
  }
  .site-nav-link:hover {
    color: var(--text);
    background: rgba(255,255,255,.06);
    text-decoration: none;
  }
  .site-nav-link.active { color: var(--text); }

  /* Narrow viewports: collapse to a column with logo on top and links
     centred below. Tighter side padding so 8 items breathe on a phone. */
  @media (max-width: 720px) {
    .site-nav {
      grid-template-columns: 1fr;
      padding: 16px 20px;
      gap: 12px;
    }
    .site-nav-logo { justify-self: center; }
    .site-nav-links {
      grid-column: 1;
      justify-self: center;
      gap: 2px;
    }
  }
</style>
