---
const pathname = Astro.url.pathname;
function isActive(prefix: string): boolean {
  if (prefix === "/") return pathname === "/";
  return pathname === prefix || pathname.startsWith(prefix + "/") || pathname === prefix.replace(/\/$/, "");
}
const links: { href: string; label: string }[] = [
  { href: "/gallery/", label: "Gallery" },
  { href: "/downloads", label: "Downloads" },
  { href: "/docs/", label: "Docs" },
  { href: "/scores/", label: "Scores" },
  { href: "/blog/", label: "Blog" },
];
---
<header class="site-nav">
  <div class="site-nav-inner">
    <a class="site-nav-logo" href="/" aria-label="Tempo home">Tempo</a>

    <details class="site-nav-menu">
      <summary aria-label="Open menu">
        <span class="hamburger" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </summary>
      <nav class="site-nav-links" aria-label="Primary">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={["site-nav-link", { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .site-nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .site-nav-logo {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.005em;
    color: var(--text);
    text-decoration: none;
  }
  .site-nav-logo:hover { color: var(--text); text-decoration: none; }

  /* Details container — no native disclosure triangle */
  .site-nav-menu {
    position: relative;
  }
  .site-nav-menu summary {
    list-style: none;
    cursor: pointer;
    display: none; /* hidden on desktop; revealed under breakpoint */
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    color: var(--text2);
    transition: color 120ms ease, background 120ms ease;
  }
  .site-nav-menu summary::-webkit-details-marker { display: none; }
  .site-nav-menu summary:hover { color: var(--text); background: var(--bg2); }

  .hamburger {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }
  .hamburger span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
  }

  .site-nav-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .site-nav-link {
    color: var(--text2);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .site-nav-link:hover { color: var(--text); text-decoration: none; }
  .site-nav-link.active { color: var(--text); font-weight: 500; }

  /* Mobile: <details> drives a dropdown; desktop keeps links inline regardless of open state */
  @media (max-width: 720px) {
    .site-nav-menu summary { display: inline-flex; align-items: center; }

    .site-nav-menu:not([open]) .site-nav-links {
      display: none;
    }
    .site-nav-menu[open] .site-nav-links {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.85rem 1rem;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      min-width: 160px;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    }
  }
</style>
