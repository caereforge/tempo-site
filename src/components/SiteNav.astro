---
const pathname = Astro.url.pathname;
function isActive(prefix: string): boolean {
  if (prefix === "/") return pathname === "/";
  return pathname === prefix || pathname.startsWith(prefix + "/") || pathname === prefix.replace(/\/$/, "");
}
// Nav items mirror the homepage nav order so both surfaces look the
// same. Story and FAQ are anchors that route back to homepage sections
// — useful from any page to jump to the narrative pitch or FAQ.
const links: { href: string; label: string }[] = [
  { href: "/#story", label: "Story" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/#faq", label: "FAQ" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/downloads", label: "Downloads" },
  { href: "/scores/", label: "Scores" },
  { href: "/docs/", label: "Docs" },
  { href: "/blog/", label: "Blog" },
];
---
<header class="site-nav">
  <div class="site-nav-inner">
    <a class="site-nav-logo" href="/" aria-label="Tempo home">Tempo</a>
    <nav class="site-nav-links" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["site-nav-link", { active: isActive(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .site-nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav-logo {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.005em;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-nav-logo:hover { color: var(--text); text-decoration: none; }

  /* Plain inline nav — always visible on desktop. On narrow viewports,
     links wrap onto multiple rows rather than collapsing into a
     hamburger. JS-free, ships without a toggle component for V1. */
  .site-nav-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-nav-link {
    color: var(--text2);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 120ms ease;
    white-space: nowrap;
  }
  .site-nav-link:hover { color: var(--text); text-decoration: none; }
  .site-nav-link.active { color: var(--text); font-weight: 500; }

  /* Narrow viewports: tighter gaps so 8 items fit without overflow,
     and let the nav block wrap below the logo if needed. */
  @media (max-width: 720px) {
    .site-nav-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .site-nav-links {
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
